{
  "artifactType": "sova.worker-deployment-policy",
  "schemaVersion": "0.2.0",
  "status": "template-not-admitted",
  "workerId": "REPLACE_WITH_WORKER_ID",
  "firecrackerVersion": "1.16.1",
