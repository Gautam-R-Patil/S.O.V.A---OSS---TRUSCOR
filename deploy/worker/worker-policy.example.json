    "identityLeaseDirectory": "/run/sova-worker/leases",
    "hostKernelImage": "/usr/local/lib/sova-worker/host-kernel-image",
    "microcodeImage": "/usr/local/lib/sova-worker/microcode-image",
    "guestKernelImage": "/usr/local/lib/sova-worker/guest-kernel",
    "rootFilesystemImage": "/usr/local/lib/sova-worker/rootfs.ext4",
    "advisorySnapshot": "/usr/local/lib/sova-worker/advisories.json"
  },
  "network": {
    "egressInterface": "REPLACE_WITH_INTERFACE",
    "mediatorUidBase": 700000,
