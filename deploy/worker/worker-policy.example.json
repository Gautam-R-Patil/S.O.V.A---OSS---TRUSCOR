    "jailerDigest": "REPLACE_WITH_SHA256",
    "ipDigest": "REPLACE_WITH_SHA256",
    "nftDigest": "REPLACE_WITH_SHA256",
    "setprivDigest": "REPLACE_WITH_SHA256",
    "networkMediatorDigest": "REPLACE_WITH_SHA256",
    "hostKernelDigest": "REPLACE_WITH_SHA256",
    "microcodeDigest": "REPLACE_WITH_SHA256",
    "guestKernelDigest": "REPLACE_WITH_SHA256",
    "rootFilesystemDigest": "REPLACE_WITH_SHA256",
    "advisorySnapshotDigest": "REPLACE_WITH_SHA256"
  },
  "requiredControls": {
    "dedicatedLinuxHost": true,
    "kvm": true,
    "cgroupV2": true,
    "swapDisabled": true,
    "defaultSeccomp": true,
    "uniqueUidGidPerJob": true,
    "rootOwnedPaths": true,
