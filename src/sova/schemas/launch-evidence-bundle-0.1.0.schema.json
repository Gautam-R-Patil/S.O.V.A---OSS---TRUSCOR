{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/launch-evidence-bundle-0.1.0.schema.json",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "trustPolicy", "protocol", "observationLedger", "registryPolicy", "operationalReceipts", "candidate", "reviewReceipts", "gateReceipts", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.launch-evidence-bundle"},
    "schemaVersion": {"const": "0.1.0"},
    "trustPolicy": {"type": "object"},
    "protocol": {"type": "object"},
    "observationLedger": {"$ref": "#/$defs/envelope"},
    "registryPolicy": {"type": "object"},
    "operationalReceipts": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/envelope"}},
    "candidate": {"type": "object"},
    "reviewReceipts": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/envelope"}},
    "gateReceipts": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/envelope"}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "object", "required": ["keyid", "sig"], "properties": {"keyid": {"$ref": "#/$defs/digest"}, "sig": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "envelope": {"type": "object", "required": ["payloadType", "payload", "signatures"], "properties": {"payloadType": {"const": "application/vnd.sova.launch-evidence+json"}, "payload": {"type": "string", "minLength": 1}, "signatures": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/signature"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
