{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/release-review-receipt-0.1.0.schema.json",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "gate", "releaseCommit", "artifactManifestDigest", "reviewer", "organization", "issuedAt", "result", "independent", "evidenceDigest", "synthetic"],
  "properties": {
    "artifactType": {"const": "sova.release-review-receipt"},
    "schemaVersion": {"const": "0.1.0"},
    "gate": {"enum": ["founder-acceptance", "independent-technical-validation", "independent-isolation-review", "legal-license-public-disclosure", "security-signoff"]},
    "releaseCommit": {"type": "string", "minLength": 1},
    "artifactManifestDigest": {"$ref": "#/$defs/digest"},
    "reviewer": {"type": "string", "minLength": 1},
    "organization": {"type": "string", "minLength": 1},
    "issuedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "result": {"enum": ["pass", "fail"]},
    "independent": {"type": "boolean"},
    "evidenceDigest": {"$ref": "#/$defs/digest"},
    "synthetic": {"type": "boolean"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
