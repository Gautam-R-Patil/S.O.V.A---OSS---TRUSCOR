{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sova-oss.org/schemas/methodology-observations-0.1.0.schema.json","title":"SOVA methodology observations 0.1.0",
  "type":"object","additionalProperties":false,"required":["artifactType","schemaVersion","targetProfileDigest","previousPlanDigest","sourceArtifactDigests","observations","claims"],
  "properties":{
    "artifactType":{"const":"sova.methodology-observations"},"schemaVersion":{"const":"0.1.0"},"targetProfileDigest":{"$ref":"#/$defs/digest"},"previousPlanDigest":{"$ref":"#/$defs/digest"},"sourceArtifactDigests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},
    "observations":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["playbookId","phase","outcome","evidenceDigest","targetGenerationDigest"],"properties":{"playbookId":{"type":"string","pattern":"^sova\\.playbook\\."},"phase":{"enum":["discovery","hypothesis","confirmation","reproduction","remediation-validation","reporting"]},"outcome":{"enum":["observed","not-observed","inconclusive","blocked","infrastructure-failure"]},"evidenceDigest":{"$ref":"#/$defs/digest"},"targetGenerationDigest":{"$ref":"#/$defs/digest"}}}},
    "claims":{"type":"object","additionalProperties":false,"required":["authorityGranted","trustedContractsMutated"],"properties":{"authorityGranted":{"const":false},"trustedContractsMutated":{"const":false}}}
  },"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
