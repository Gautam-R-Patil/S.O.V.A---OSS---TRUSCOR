{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/public-claims-snapshot-0.1.0.schema.json",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "releaseCommit", "capturedAt", "surfaces", "publicClaimsReady", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.public-claims-snapshot"},
    "schemaVersion": {"const": "0.1.0"},
    "releaseCommit": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "surfaces": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/surface"}
    },
    "publicClaimsReady": {"type": "boolean"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "surface": {
      "type": "object",
      "required": ["id", "kind", "locator", "contentDigest", "status", "reviewed", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["readme", "documentation", "demo", "website", "paper", "registry", "release-notes"]},
        "locator": {"type": "string", "minLength": 1},
        "contentDigest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["reconciled", "hold"]},
        "reviewed": {"type": "boolean"},
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
