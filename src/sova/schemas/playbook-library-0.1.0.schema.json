{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sova-oss.org/schemas/playbook-library-0.1.0.schema.json",
  "title":"SOVA playbook library 0.1.0",
  "type":"object","additionalProperties":false,
  "required":["artifactType","schemaVersion","id","version","released","sources","playbooks","claims"],
  "properties":{
    "artifactType":{"const":"sova.playbook-library"},"schemaVersion":{"const":"0.1.0"},
    "id":{"type":"string","minLength":1,"maxLength":191},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"released":{"type":"string","format":"date"},
    "sources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["key","framework","catalogVersion","url","license","usage"],"properties":{"key":{"type":"string","minLength":1},"framework":{"type":"string","minLength":1},"catalogVersion":{"type":"string","minLength":1},"url":{"type":"string","format":"uri","pattern":"^https://"},"license":{"type":"string","minLength":1},"usage":{"const":"reference-mapping-only"}}}},
    "playbooks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","required":["artifactType","schemaVersion","id"],"properties":{"artifactType":{"const":"sova.playbook"},"schemaVersion":{"const":"0.1.0"},"id":{"type":"string","pattern":"^sova\\.playbook\\."}}}},
    "claims":{"type":"object","additionalProperties":false,"required":["externalProseEmbedded","thirdPartyDatasetsEmbedded","allTargetsCovered","allVulnerabilitiesCovered"],"properties":{"externalProseEmbedded":{"const":false},"thirdPartyDatasetsEmbedded":{"const":false},"allTargetsCovered":{"const":false},"allVulnerabilitiesCovered":{"const":false}}}
  }
}
