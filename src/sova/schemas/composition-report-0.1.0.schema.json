{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/composition-report-0.1.0.schema.json",
  "title": "SOVA composition search report 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "strategy", "attempts", "successfulCandidate", "minimizedCandidate", "elementAttribution", "compositionOnlyConfirmed", "stopReason", "limitations"],
  "properties": {
    "artifactType": {"const": "sova.composition-report"},
    "schemaVersion": {"const": "0.1.0"},
    "strategy": {"enum": ["pairwise", "bounded-t-wise", "risk-guided-path", "trigger-aware-sequence"]},
    "attempts": {"type": "array", "maxItems": 100000, "items": {"type": "object", "additionalProperties": false, "required": ["index", "candidate", "observation"], "properties": {"index": {"type": "integer", "minimum": 0}, "candidate": {"$ref": "#/$defs/candidate"}, "observation": {"$ref": "#/$defs/observation"}}}},
    "successfulCandidate": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "minimizedCandidate": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "elementAttribution": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["elementId", "elementKind", "removalState", "necessaryUnderTest", "evidenceComplete"], "properties": {"elementId": {"type": "string"}, "elementKind": {"enum": ["edge", "node"]}, "removalState": {"enum": ["effect-prevented", "effect-persisted", "inconclusive"]}, "necessaryUnderTest": {"type": ["boolean", "null"]}, "evidenceComplete": {"type": "boolean"}}}},
    "compositionOnlyConfirmed": {"type": "boolean"},
    "stopReason": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "candidate": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges", "sequence", "digest", "parentDigest"], "properties": {"nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "edges": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "sequence": {"type": "array", "items": {"type": "string"}}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "parentDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["triggered", "evidenceComplete", "oracleState", "traceReferences", "individualOutcomes", "limitations"], "properties": {"triggered": {"type": ["boolean", "null"]}, "evidenceComplete": {"type": "boolean"}, "oracleState": {"type": "string"}, "traceReferences": {"type": "array", "items": {"type": "string"}}, "individualOutcomes": {"type": "object", "additionalProperties": {"type": ["boolean", "null"]}}, "limitations": {"type": "array", "items": {"type": "string"}}}}
  }
}
