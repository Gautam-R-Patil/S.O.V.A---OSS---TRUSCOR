{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/worker-secret-receipt-0.1.0.schema.json",
  "title": "SOVA worker secret receipt 0.1.0",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "jobId", "grantName", "audience", "kind", "observedAt", "useNumber", "secretDigest", "decision", "reason", "claims", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.worker-secret-receipt"}, "schemaVersion": {"const": "0.1.0"}, "jobId": {"type": "string"}, "grantName": {"type": "string"}, "audience": {"type": "string"}, "kind": {"type": "string"}, "observedAt": {"type": "string", "format": "date-time"}, "useNumber": {"type": "integer", "minimum": 0}, "secretDigest": {"$ref": "#/$defs/digest"}, "decision": {"enum": ["allowed", "denied"]}, "reason": {"type": "string"},
    "claims": {"type": "object", "required": ["secretValueEmbedded", "capabilityTokenEmbedded", "hostPathOrSocketGranted"], "properties": {"secretValueEmbedded": {"const": false}, "capabilityTokenEmbedded": {"const": false}, "hostPathOrSocketGranted": {"const": false}}, "additionalProperties": false},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
