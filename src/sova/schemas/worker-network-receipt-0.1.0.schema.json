{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/worker-network-receipt-0.1.0.schema.json",
  "title": "SOVA worker network receipt 0.1.0",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "jobId", "sequence", "observedAt", "endpoint", "pinnedAddresses", "resolvedAddresses", "selectedAddress", "requestedBytes", "decision", "reason", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.worker-network-receipt"}, "schemaVersion": {"const": "0.1.0"},
    "jobId": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1}, "observedAt": {"type": "string", "format": "date-time"},
    "endpoint": {"type": "object", "required": ["hostname", "port", "protocol"], "properties": {"hostname": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"enum": ["tcp", "udp"]}}, "additionalProperties": false},
    "pinnedAddresses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "resolvedAddresses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "selectedAddress": {"type": ["string", "null"]}, "requestedBytes": {"type": "integer", "minimum": 0}, "decision": {"enum": ["allowed", "denied"]}, "reason": {"type": "string"}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
