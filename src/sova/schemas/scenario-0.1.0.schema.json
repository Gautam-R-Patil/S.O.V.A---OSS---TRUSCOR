{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schema/scenario/0.1.0",
  "title": "SOVA scenario 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "id",
    "version",
    "title",
    "purpose",
    "parameters",
    "preconditions",
    "sequences",
    "procedure",
    "triggers",
    "mutations",
    "expectedEffects",
    "oracles",
    "evidenceRequirements",
    "safety",
    "cleanup",
    "limitations",
    "extensions"
  ],
  "properties": {
    "artifactType": {"const": "sova.scenario"},
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^sova:scenario:[0-9a-f-]{36}$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 4000},
    "parameters": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "object"}},
    "sequences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"},
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {"$ref": "#/$defs/step"}
          }
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "triggers": {"type": "array", "items": {"type": "object"}},
    "mutations": {"type": "array", "items": {"type": "object"}},
    "expectedEffects": {"type": "array", "items": {"type": "object"}},
    "oracles": {"type": "array", "items": {"type": "object"}},
    "evidenceRequirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgets", "forbiddenEffects", "stopConditions"],
      "properties": {
        "budgets": {"type": "object"},
        "forbiddenEffects": {"type": "array", "items": {"type": "string"}},
        "stopConditions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "cleanup": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^x-[a-z0-9][a-z0-9.-]{0,62}$"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "inputs", "onFailure"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"},
        "action": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,126}$"},
        "inputs": {"type": "object"},
        "when": {"type": "object"},
        "onFailure": {"enum": ["stop", "continue", "inconclusive"]},
        "requires": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
