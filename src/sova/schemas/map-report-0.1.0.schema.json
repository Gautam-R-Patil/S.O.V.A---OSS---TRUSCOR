{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/map-report-0.1.0.schema.json",
  "title": "SOVA capability map report 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "id",
    "methodology",
    "inputs",
    "inventory",
    "graph",
    "closures",
    "findings",
    "toolDrift",
    "coverage",
    "limitations",
    "claims",
    "contentDigest"
  ],
  "properties": {
    "artifactType": {"const": "sova.map"},
    "schemaVersion": {"const": "0.1.0"},
    "id": {
      "type": "string",
      "pattern": "^sova:artifact:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "methodology": {"const": "sova.capability-reach/0.1.0"},
    "inputs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "status"],
        "properties": {
          "path": {"type": "string", "maxLength": 4096},
          "kind": {"type": "string", "maxLength": 128},
          "status": {"type": "string", "maxLength": 128}
        }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "kind", "name", "risk", "rationale"],
        "properties": {
          "nodeId": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"},
          "kind": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "risk": {"enum": ["info", "low", "medium", "high"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "closures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "witnessLinked", "possible", "conflicts"],
      "properties": {
        "declared": {"$ref": "#/$defs/closure"},
        "witnessLinked": {"$ref": "#/$defs/closure"},
        "possible": {"$ref": "#/$defs/closure"},
        "conflicts": {"$ref": "#/$defs/closure"}
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/finding"}
    },
    "toolDrift": {"type": "array", "maxItems": 100000, "items": {"type": "object"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCount", "edgeCount", "findingCount", "partial"],
      "properties": {
        "nodeCount": {"type": "integer", "minimum": 0},
        "edgeCount": {"type": "integer", "minimum": 0},
        "findingCount": {"type": "integer", "minimum": 0},
        "partial": {"type": "boolean"}
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "maxLength": 4096}
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executedVulnerability", "safeOrClean", "inferenceIsEvidence"],
      "properties": {
        "executedVulnerability": {"const": false},
        "safeOrClean": {"const": false},
        "inferenceIsEvidence": {"const": false}
      }
    },
    "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pointer", "evidenceClass", "projectionDigest"],
      "properties": {
        "source": {"type": "string", "maxLength": 4096},
        "pointer": {"type": "string", "maxLength": 4096},
        "evidenceClass": {"enum": ["declared", "observed", "inferred", "refuted"]},
        "projectionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "attributes", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"},
        "kind": {
          "enum": [
            "agent",
            "sub-agent",
            "mcp-server",
            "tool",
            "skill",
            "plugin",
            "package",
            "identity",
            "permission",
            "data-source",
            "destination",
            "approval-gate",
            "external-system",
            "runtime"
          ]
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "attributes": {"type": "object"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "kind", "evidenceClass", "attributes", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^map:edge:[0-9a-f]{32}$"},
        "source": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"},
        "target": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"},
        "kind": {
          "enum": [
            "declares",
            "delegates",
            "invokes",
            "uses",
            "grants",
            "reads",
            "writes",
            "reaches",
            "egress",
            "protected-by",
            "depends-on"
          ]
        },
        "evidenceClass": {"enum": ["declared", "observed", "inferred", "refuted"]},
        "attributes": {"type": "object"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "closure": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "edgeIds"],
        "properties": {
          "source": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"},
          "target": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"},
          "edgeIds": {
            "type": "array",
            "items": {"type": "string", "pattern": "^map:edge:[0-9a-f]{32}$"}
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "title", "nodeIds", "edgeIds", "evidenceClass", "explanation"],
      "properties": {
        "code": {"type": "string", "pattern": "^SOVA-MAP-[A-Z0-9-]+$"},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "nodeIds": {"type": "array", "items": {"type": "string", "pattern": "^map:[a-z-]+:[0-9a-f]{32}$"}},
        "edgeIds": {"type": "array", "items": {"type": "string", "pattern": "^map:edge:[0-9a-f]{32}$"}},
        "evidenceClass": {"enum": ["declared", "observed", "inferred", "refuted"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
