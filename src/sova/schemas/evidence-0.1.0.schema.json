{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/evidence-0.1.0.schema.json",
  "title": "SOVA self-assessment evidence 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "finding", "evidence", "conditionsTested", "coverage", "reproduction", "taxonomyMappings", "methodology", "suggestedMitigations", "regressionEvidence", "attachments", "lifecycle", "limitations", "assuranceBoundary"],
  "properties": {
    "artifactType": {"const": "sova.evidence"},
    "schemaVersion": {"const": "0.1.0"},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "affected", "technicalSeverity", "harmCategory"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "title": {"type": "string", "minLength": 1, "maxLength": 1024},
        "summary": {"type": "string", "minLength": 1, "maxLength": 16384},
        "affected": {"type": "object", "additionalProperties": false, "required": ["component", "version", "identifiers"], "properties": {"component": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "identifiers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
        "technicalSeverity": {"enum": ["unknown", "informational", "low", "medium", "high", "critical"]},
        "harmCategory": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "evidence": {"type": "array", "minItems": 2, "maxItems": 10000, "items": {"$ref": "#/$defs/reference"}},
    "conditionsTested": {"type": "array", "maxItems": 10000, "items": {"type": "string", "minLength": 1}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["testedCount", "denominator", "detectionFloor", "absenceMeansSafe"], "properties": {"testedCount": {"type": "integer", "minimum": 0}, "denominator": {"type": ["integer", "null"], "minimum": 0}, "detectionFloor": {"type": "string", "minLength": 1}, "absenceMeansSafe": {"const": false}}},
    "reproduction": {"type": "object"},
    "taxonomyMappings": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "string"}}},
    "methodology": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "suggestedMitigations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "regressionEvidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "lifecycle": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assuranceBoundary": {"type": "object", "additionalProperties": false, "required": ["selfGenerated", "independentAttestation", "watermark"], "properties": {"selfGenerated": {"const": true}, "independentAttestation": {"const": false}, "watermark": {"const": "SELF-GENERATED SOVA EVIDENCE - NOT INDEPENDENT ATTESTATION"}}}
  },
  "$defs": {
    "reference": {"type": "object", "additionalProperties": false, "required": ["role", "uri", "digest", "mediaType", "verified"], "properties": {"role": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "mediaType": {"type": "string", "minLength": 1}, "verified": {"type": "boolean"}}}
  }
}
