{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/blinded-oracle-study-0.1.0.schema.json",
  "title": "SOVA Blinded Oracle Study 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "core", "answerKeyCommitment", "labelsPresent"],
  "properties": {
    "artifactType": {"const": "sova.blinded-oracle-study"}, "schemaVersion": {"const": "0.1.0"},
    "core": {"type": "object", "additionalProperties": false, "required": ["proposalDigest", "seed", "policy", "cases", "limitations"], "properties": {
      "proposalDigest": {"$ref": "#/$defs/digest"}, "seed": {"type": "integer"},
      "policy": {"type": "object", "additionalProperties": false, "required": ["minimumPositiveCases", "minimumNegativeCases", "maximumFalsePositives", "maximumMisses", "requireAmbiguousAbstention", "requireInfrastructureSeparation"], "properties": {"minimumPositiveCases": {"type": "integer", "minimum": 1}, "minimumNegativeCases": {"type": "integer", "minimum": 1}, "maximumFalsePositives": {"type": "integer", "minimum": 0}, "maximumMisses": {"type": "integer", "minimum": 0}, "requireAmbiguousAbstention": {"type": "boolean"}, "requireInfrastructureSeparation": {"type": "boolean"}}},
      "cases": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "signal", "targetGeneration", "environmentFingerprint", "evidenceDigests"], "properties": {"id": {"$ref": "#/$defs/text"}, "signal": {"$ref": "#/$defs/text"}, "targetGeneration": {"$ref": "#/$defs/text"}, "environmentFingerprint": {"$ref": "#/$defs/digest"}, "evidenceDigests": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/digest"}}}}},
      "limitations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/text"}}
    }},
    "answerKeyCommitment": {"$ref": "#/$defs/digest"}, "labelsPresent": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "text": {"type": "string", "minLength": 1, "maxLength": 4096}}
}
