{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/launch-dossier-0.1.0.schema.json",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "releaseCommit", "artifactManifestDigest", "claimsRegisterDigest", "publicClaimsSnapshotDigest", "bundleDigest", "trustPolicyDigest", "protocolDigest", "observationLedgerDigest", "evaluationReportDigest", "registryPolicyDigest", "registryReadinessDigest", "releaseCandidateDigest", "releaseGateLedgerDigest", "trustedSignerKeyIds", "receiptCounts", "sourceBindings", "gateReceipts", "evaluationSummary", "registrySummary", "reviewSummary", "externalGates", "holdReasons", "status", "tagOrPublishAllowed", "automaticPublishPerformed", "claims", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.launch-dossier"},
    "schemaVersion": {"const": "0.1.0"},
    "releaseCommit": {"type": "string", "minLength": 1},
    "artifactManifestDigest": {"$ref": "#/$defs/digest"},
    "claimsRegisterDigest": {"$ref": "#/$defs/digest"},
    "publicClaimsSnapshotDigest": {"$ref": "#/$defs/digest"},
    "bundleDigest": {"$ref": "#/$defs/digest"},
    "trustPolicyDigest": {"$ref": "#/$defs/digest"},
    "protocolDigest": {"$ref": "#/$defs/digest"},
    "observationLedgerDigest": {"$ref": "#/$defs/digest"},
    "evaluationReportDigest": {"$ref": "#/$defs/digest"},
    "registryPolicyDigest": {"$ref": "#/$defs/digest"},
    "registryReadinessDigest": {"$ref": "#/$defs/digest"},
    "releaseCandidateDigest": {"$ref": "#/$defs/digest"},
    "releaseGateLedgerDigest": {"$ref": "#/$defs/digest"},
    "trustedSignerKeyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "receiptCounts": {
      "type": "object",
      "required": ["operational", "reviews", "launchGates"],
      "properties": {
        "operational": {"type": "integer", "minimum": 0, "maximum": 10},
        "reviews": {"type": "integer", "minimum": 0, "maximum": 5},
        "launchGates": {"type": "integer", "minimum": 0, "maximum": 3}
      },
      "additionalProperties": false
    },
    "sourceBindings": {
      "type": "object",
      "required": ["expectedCommit", "artifactManifest", "claimsRegister", "publicClaimsSnapshot", "trustPolicyPinned", "protocol", "evaluationReport", "registryReadiness", "signedEvidence"],
      "properties": {
        "expectedCommit": {"const": true},
        "artifactManifest": {"const": true},
        "claimsRegister": {"const": true},
        "publicClaimsSnapshot": {"const": true},
        "trustPolicyPinned": {"const": true},
        "protocol": {"const": true},
        "evaluationReport": {"const": true},
        "registryReadiness": {"const": true},
        "signedEvidence": {"const": true}
      },
      "additionalProperties": false
    },
    "gateReceipts": {
      "type": "object",
      "required": ["p5-production-isolation", "blinded-field-validation", "deterministic-release-checks"],
      "properties": {
        "p5-production-isolation": {"$ref": "#/$defs/gateReceipt"},
        "blinded-field-validation": {"$ref": "#/$defs/gateReceipt"},
        "deterministic-release-checks": {"$ref": "#/$defs/gateReceipt"}
      },
      "additionalProperties": false
    },
    "evaluationSummary": {
      "type": "object",
      "required": ["status", "expectedRuns", "observedRuns", "missingRunCount", "budgetExceedanceCount"],
      "properties": {
        "status": {"enum": ["conclusive", "incomplete-or-inconclusive"]},
        "expectedRuns": {"type": "integer", "minimum": 1},
        "observedRuns": {"type": "integer", "minimum": 0},
        "missingRunCount": {"type": "integer", "minimum": 0},
        "budgetExceedanceCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "registrySummary": {
      "type": "object",
      "required": ["liveBetaReady", "missingControls", "failedControls", "syntheticControls", "nonproductionControls", "unauthorizedIssuerControls"],
      "properties": {
        "liveBetaReady": {"type": "boolean"},
        "missingControls": {"$ref": "#/$defs/stringArray"},
        "failedControls": {"$ref": "#/$defs/stringArray"},
        "syntheticControls": {"$ref": "#/$defs/stringArray"},
        "nonproductionControls": {"$ref": "#/$defs/stringArray"},
        "unauthorizedIssuerControls": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "reviewSummary": {
      "type": "object",
      "required": ["missingReviews", "failedReviews", "syntheticReviews", "independenceFailures"],
      "properties": {
        "missingReviews": {"$ref": "#/$defs/stringArray"},
        "failedReviews": {"$ref": "#/$defs/stringArray"},
        "syntheticReviews": {"$ref": "#/$defs/stringArray"},
        "independenceFailures": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "externalGates": {
      "type": "object",
      "required": ["p5ProductionIsolation", "blindedFieldValidation", "registryLiveBeta", "deterministicReleaseChecks", "publicClaimsReconciled", "blindedResultsPublic", "limitationsPublic"],
      "properties": {
        "p5ProductionIsolation": {"type": "boolean"},
        "blindedFieldValidation": {"type": "boolean"},
        "registryLiveBeta": {"type": "boolean"},
        "deterministicReleaseChecks": {"type": "boolean"},
        "publicClaimsReconciled": {"type": "boolean"},
        "blindedResultsPublic": {"type": "boolean"},
        "limitationsPublic": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "holdReasons": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["ready", "hold"]},
    "tagOrPublishAllowed": {"type": "boolean"},
    "automaticPublishPerformed": {"const": false},
    "claims": {
      "type": "object",
      "required": ["allEvidenceRecomputed", "signaturesProveTrustedKeyPossession", "reviewerIdentityLegallyVerifiedBySova", "universalSecurityEstablished", "allVulnerabilitiesFound", "perfectIsolationEstablished"],
      "properties": {
        "allEvidenceRecomputed": {"const": true},
        "signaturesProveTrustedKeyPossession": {"const": true},
        "reviewerIdentityLegallyVerifiedBySova": {"const": false},
        "universalSecurityEstablished": {"const": false},
        "allVulnerabilitiesFound": {"const": false},
        "perfectIsolationEstablished": {"const": false}
      },
      "additionalProperties": false
    },
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gateReceipt": {
      "type": "object",
      "required": ["present", "passed", "receiptDigest"],
      "properties": {
        "present": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "receiptDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
      "then": {"properties": {"holdReasons": {"maxItems": 0}, "tagOrPublishAllowed": {"const": true}}},
      "else": {"properties": {"holdReasons": {"minItems": 1}, "tagOrPublishAllowed": {"const": false}}}
    }
  ],
  "additionalProperties": false
}
