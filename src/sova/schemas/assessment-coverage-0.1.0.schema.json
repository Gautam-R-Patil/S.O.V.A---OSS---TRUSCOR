{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/assessment-coverage-0.1.0.schema.json",
  "title": "SOVA Assessment Coverage 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "targetProfileDigest", "methodologyPlanDigest", "dimensions", "gaps", "claims", "limitations", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.assessment-coverage"}, "schemaVersion": {"const": "0.1.0"}, "targetProfileDigest": {"$ref": "#/$defs/digest"}, "methodologyPlanDigest": {"$ref": "#/$defs/digest"},
    "dimensions": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["dimension", "items", "counts", "knownDenominator", "positiveEvidenceCount", "positiveEvidenceRatio"], "properties": {"dimension": {"$ref": "#/$defs/dimension"}, "items": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/item"}}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "knownDenominator": {"type": "integer", "minimum": 0}, "positiveEvidenceCount": {"type": "integer", "minimum": 0}, "positiveEvidenceRatio": {"type": ["string", "null"]}}}},
    "gaps": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["dimension", "subject", "state", "reason"], "properties": {"dimension": {"$ref": "#/$defs/dimension"}, "subject": {"$ref": "#/$defs/text"}, "state": {"enum": ["not-observed", "unsupported", "blocked", "inconclusive", "infrastructure-failure", "unknown"]}, "reason": {"$ref": "#/$defs/text"}}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["exhaustive", "allWorkflowsUnderstood", "allAttackSurfacesEnumerated", "allVulnerabilitiesFound", "safeOrClean", "unknownIsPass", "notObservedIsSafe", "infrastructureFailureIsPass"], "properties": {"exhaustive": {"const": false}, "allWorkflowsUnderstood": {"const": false}, "allAttackSurfacesEnumerated": {"const": false}, "allVulnerabilitiesFound": {"const": false}, "safeOrClean": {"const": false}, "unknownIsPass": {"const": false}, "notObservedIsSafe": {"const": false}, "infrastructureFailureIsPass": {"const": false}}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/text"}}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "text": {"type": "string", "minLength": 1, "maxLength": 4096}, "dimension": {"enum": ["workflow", "surface", "playbook", "state", "identity-role", "adapter", "oracle", "reproduction"]}, "state": {"enum": ["declared", "discovered", "exercised", "reproduced", "not-observed", "unsupported", "blocked", "inconclusive", "infrastructure-failure", "unknown"]}, "item": {"type": "object", "additionalProperties": false, "required": ["subject", "state", "evidenceDigests", "reason"], "properties": {"subject": {"$ref": "#/$defs/text"}, "state": {"$ref": "#/$defs/state"}, "evidenceDigests": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/digest"}}, "reason": {"$ref": "#/$defs/text"}}}}
}
