{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/oracle-proposal-0.1.0.schema.json",
  "title": "SOVA Oracle Proposal 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "id", "targetProfileDigest", "source", "statement", "evaluator", "signals", "sourceReferences", "evidenceRequirements", "knownBlindSpots", "disposition", "claims", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.oracle-proposal"},
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,190}$"},
    "targetProfileDigest": {"$ref": "#/$defs/digest"},
    "source": {"enum": ["target-contract", "specification", "invariant", "differential", "metamorphic", "state-effect", "log", "human-acceptance"]},
    "statement": {"$ref": "#/$defs/text"},
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "configDigest"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "configDigest": {"$ref": "#/$defs/digest"}}
    },
    "signals": {
      "type": "object", "additionalProperties": false,
      "required": ["positive", "negative", "ambiguous"],
      "properties": {"positive": {"$ref": "#/$defs/text"}, "negative": {"$ref": "#/$defs/text"}, "ambiguous": {"$ref": "#/$defs/text"}}
    },
    "sourceReferences": {"$ref": "#/$defs/textArray"},
    "evidenceRequirements": {"$ref": "#/$defs/textArray"},
    "knownBlindSpots": {"$ref": "#/$defs/textArray"},
    "disposition": {"const": "unvalidated-proposal"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["executionAuthorized", "findingConfirmed", "universallyReliable"],
      "properties": {"executionAuthorized": {"const": false}, "findingConfirmed": {"const": false}, "universallyReliable": {"const": false}}
    },
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "textArray": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
