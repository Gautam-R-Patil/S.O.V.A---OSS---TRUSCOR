{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/launch-trust-policy-0.1.0.schema.json",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "releaseCommit", "artifactManifestDigest", "releaseCandidateDigest", "principals", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.launch-trust-policy"},
    "schemaVersion": {"const": "0.1.0"},
    "releaseCommit": {"type": "string", "minLength": 1},
    "artifactManifestDigest": {"$ref": "#/$defs/digest"},
    "releaseCandidateDigest": {"$ref": "#/$defs/digest"},
    "principals": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/principal"}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "principal": {
      "type": "object",
      "required": ["keyId", "publicKey", "name", "organization", "roles"],
      "properties": {
        "keyId": {"$ref": "#/$defs/digest"},
        "publicKey": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["evaluation-custodian", "registry-operator", "p5-isolation-operator", "release-operator", "founder", "independent-technical", "independent-isolation", "legal-license-public-disclosure", "security"]}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
