{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.dev/schemas/blinded-evaluation-protocol-0.1.0.schema.json",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "id", "registeredAt", "releaseCommit", "targets", "lanes", "repetitions", "seed", "runCount", "budgetPerRun", "scoringRulesDigest", "metrics", "exclusions", "failureRules", "answerKeyCustodian", "answerKeyEmbedded", "resultsRequiredPublic", "negativeResultsRetained"],
  "properties": {
    "artifactType": {"const": "sova.blinded-evaluation-protocol"},
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "minLength": 1},
    "registeredAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "releaseCommit": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 8, "maxItems": 10000, "items": {"$ref": "#/$defs/target"}},
    "lanes": {"type": "array", "minItems": 4, "maxItems": 100, "items": {"$ref": "#/$defs/lane"}},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
    "seed": {"type": "integer"},
    "runCount": {"type": "integer", "minimum": 32, "maximum": 100000},
    "budgetPerRun": {"$ref": "#/$defs/budget"},
    "scoringRulesDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "metrics": {"const": ["workflow-coverage", "surface-coverage", "confirmed-findings", "fresh-reproduction", "precision-false-positives", "infrastructure-failures", "cost", "latency", "containment"]},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "failureRules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "answerKeyCustodian": {"type": "string", "minLength": 1},
    "answerKeyEmbedded": {"const": false},
    "resultsRequiredPublic": {"const": true},
    "negativeResultsRetained": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targetClass": {"enum": ["web", "api", "package", "oci", "network", "desktop", "ai-model-agent", "mcp-a2a"]},
    "target": {
      "type": "object",
      "required": ["id", "targetClass", "inputDigest", "answerKeyCommitment", "authorizationReceiptDigest", "sourceRevision", "licenseIdentifier", "containmentBackend", "blinded", "ownedOrLicensed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "targetClass": {"$ref": "#/$defs/targetClass"},
        "inputDigest": {"$ref": "#/$defs/digest"},
        "answerKeyCommitment": {"$ref": "#/$defs/digest"},
        "authorizationReceiptDigest": {"$ref": "#/$defs/digest"},
        "sourceRevision": {"type": "string", "minLength": 1},
        "licenseIdentifier": {"type": "string", "minLength": 1},
        "containmentBackend": {"type": "string", "minLength": 1},
        "blinded": {"const": true},
        "ownedOrLicensed": {"const": true}
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": ["id", "kind", "provider", "model", "harness", "configurationDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["candidate", "baseline", "scripted", "weak-model"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "configurationDigest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["maximumActions", "maximumWallSeconds", "maximumInputBytes", "maximumOutputBytes", "maximumCostMicrousd"],
      "properties": {
        "maximumActions": {"type": "integer", "minimum": 1},
        "maximumWallSeconds": {"type": "integer", "minimum": 1},
        "maximumInputBytes": {"type": "integer", "minimum": 1},
        "maximumOutputBytes": {"type": "integer", "minimum": 1},
        "maximumCostMicrousd": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
