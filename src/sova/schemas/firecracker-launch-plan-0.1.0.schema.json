{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/firecracker-launch-plan-0.1.0.schema.json",
  "title": "SOVA Firecracker launch plan 0.1.0",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "jobId", "vmId", "manifestDigest", "firecrackerVersion", "identity", "identitySlot", "jailer", "stagedContent", "cgroupValues", "apiRequests", "watchdogSeconds", "maximumLogBytes", "invariants", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.firecracker-launch-plan"}, "schemaVersion": {"const": "0.1.0"}, "jobId": {"type": "string", "minLength": 1}, "vmId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}, "manifestDigest": {"$ref": "#/$defs/digest"}, "firecrackerVersion": {"const": "1.16.1"},
    "identity": {"type": "object", "required": ["uid", "gid", "uniquePerJob"], "properties": {"uid": {"type": "integer", "minimum": 100000, "maximum": 600000}, "gid": {"type": "integer", "minimum": 100000, "maximum": 600000}, "uniquePerJob": {"const": true}}, "additionalProperties": false}, "identitySlot": {"type": "integer", "minimum": 0, "maximum": 500000},
    "jailer": {"type": "object", "required": ["argv", "chrootDirectory", "networkNamespace", "apiSocket", "pidFile", "cgroupDirectory", "seccompLevel"], "properties": {"argv": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 64}, "chrootDirectory": {"type": "string", "minLength": 1}, "networkNamespace": {"type": "string", "minLength": 1}, "apiSocket": {"const": "/api.socket"}, "pidFile": {"type": "string", "pattern": "^/[A-Za-z0-9_.-]+\\.pid$"}, "cgroupDirectory": {"type": "string", "minLength": 1}, "seccompLevel": {"const": 2}}, "additionalProperties": false},
    "stagedContent": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["source", "destination", "mode"], "properties": {"source": {"type": "string", "minLength": 1}, "destination": {"type": "string", "minLength": 1}, "mode": {"enum": ["copy-read-only", "copy-disposable-writable"]}}, "additionalProperties": false}},
    "cgroupValues": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["key", "value"], "properties": {"key": {"enum": ["cpu.max", "memory.max", "pids.max"]}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "apiRequests": {"type": "array", "items": {"type": "object", "required": ["path", "payload"], "properties": {"path": {"enum": ["/boot-source", "/machine-config", "/drives/rootfs", "/drives/writable", "/network-interfaces/eth0", "/actions"]}, "payload": {"type": "object"}}, "additionalProperties": false}, "minItems": 5, "maxItems": 6}, "watchdogSeconds": {"type": "integer", "minimum": 16, "maximum": 86415}, "maximumLogBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "invariants": {"type": "object", "required": ["oneVmPerJob", "hostMountsAllowed", "rootFilesystemReadOnly", "writableLayerDisposable", "ambientNetworkAllowed", "pciEnabled", "serialConsoleEnabled"], "properties": {"oneVmPerJob": {"const": true}, "hostMountsAllowed": {"const": false}, "rootFilesystemReadOnly": {"const": true}, "writableLayerDisposable": {"const": true}, "ambientNetworkAllowed": {"const": false}, "pciEnabled": {"const": false}, "serialConsoleEnabled": {"const": false}}, "additionalProperties": false},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
