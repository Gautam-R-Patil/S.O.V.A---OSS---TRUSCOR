{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova-oss.org/schemas/firecracker-launch-plan-0.1.0.schema.json",
  "title": "SOVA Firecracker launch plan 0.1.0",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "jobId", "vmId", "manifestDigest", "firecrackerVersion", "identity", "identitySlot", "jailer", "stagedContent", "cgroupValues", "apiRequests", "watchdogSeconds", "maximumLogBytes", "invariants", "contentDigest"],
  "properties": {
    "artifactType": {"const": "sova.firecracker-launch-plan"}, "schemaVersion": {"const": "0.1.0"}, "jobId": {"type": "string"}, "vmId": {"type": "string"}, "manifestDigest": {"$ref": "#/$defs/digest"}, "firecrackerVersion": {"const": "1.16.1"},
    "identity": {"type": "object", "required": ["uid", "gid", "uniquePerJob"], "properties": {"uid": {"type": "integer", "minimum": 100000}, "gid": {"type": "integer", "minimum": 100000}, "uniquePerJob": {"const": true}}, "additionalProperties": false}, "identitySlot": {"type": "integer", "minimum": 0},
    "jailer": {"type": "object", "required": ["argv", "chrootDirectory", "networkNamespace", "apiSocket", "pidFile", "seccompLevel"], "properties": {"argv": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "chrootDirectory": {"type": "string"}, "networkNamespace": {"type": "string"}, "apiSocket": {"type": "string"}, "pidFile": {"type": "string"}, "seccompLevel": {"const": 2}}, "additionalProperties": false},
    "stagedContent": {"type": "array", "items": {"type": "object"}, "minItems": 3}, "cgroupValues": {"type": "array", "items": {"type": "object"}, "minItems": 3}, "apiRequests": {"type": "array", "items": {"type": "object"}, "minItems": 5}, "watchdogSeconds": {"type": "integer", "minimum": 1}, "maximumLogBytes": {"type": "integer", "minimum": 1},
    "invariants": {"type": "object", "required": ["oneVmPerJob", "hostMountsAllowed", "rootFilesystemReadOnly", "writableLayerDisposable", "ambientNetworkAllowed", "pciEnabled", "serialConsoleEnabled"], "properties": {"oneVmPerJob": {"const": true}, "hostMountsAllowed": {"const": false}, "rootFilesystemReadOnly": {"const": true}, "writableLayerDisposable": {"const": true}, "ambientNetworkAllowed": {"const": false}, "pciEnabled": {"const": false}, "serialConsoleEnabled": {"const": false}}, "additionalProperties": false},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
