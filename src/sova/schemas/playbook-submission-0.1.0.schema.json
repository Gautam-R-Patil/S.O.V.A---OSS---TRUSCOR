{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sova-oss.org/schemas/playbook-submission-0.1.0.schema.json","title":"SOVA signed playbook submission 0.1.0",
  "type":"object","additionalProperties":false,"required":["artifactType","schemaVersion","playbookDigest","envelope","publicKey","trustPolicy","review"],
  "properties":{"artifactType":{"const":"sova.playbook-submission"},"schemaVersion":{"const":"0.1.0"},"playbookDigest":{"$ref":"#/$defs/digest"},"envelope":{"type":"object","additionalProperties":false,"required":["payloadType","payload","signatures"],"properties":{"payloadType":{"const":"application/vnd.sova.playbook+json"},"payload":{"type":"string","minLength":1},"signatures":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["keyid","sig"],"properties":{"keyid":{"$ref":"#/$defs/digest"},"sig":{"type":"string","minLength":1}}}}}},"publicKey":{"type":"object","additionalProperties":false,"required":["algorithm","keyid","raw"],"properties":{"algorithm":{"const":"ed25519"},"keyid":{"$ref":"#/$defs/digest"},"raw":{"type":"string","minLength":1}}},"trustPolicy":{"const":"included-key-integrity-only"},"review":{"type":"object","additionalProperties":false,"required":["schemaValid","semanticValid","provenancePresent","evidenceLimitsPresent","mappingLinksPinned","humanReviewRequired","acceptedForLocalStaging","publisherIdentityEstablished"],"properties":{"schemaValid":{"const":true},"semanticValid":{"const":true},"provenancePresent":{"const":true},"evidenceLimitsPresent":{"const":true},"mappingLinksPinned":{"const":true},"humanReviewRequired":{"const":true},"acceptedForLocalStaging":{"const":true},"publisherIdentityEstablished":{"const":false}}}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
